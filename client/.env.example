# The Skin Tree: Public Client Environment (.env.example)
# Hard Rule 2: Public code must NEVER have any credential for or reference to clinical data.
# Role-based database connection: web_api ONLY.
WEB_DATABASE_URL="postgresql://web_api.YOUR_PROJECT_REF:YOUR_WEB_API_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# AI Consultation Assistant (Gemini Only)
GEMINI_API_KEY="your-gemini-api-key"
# Optional Secondary Google Gemini API Key (separate project for hedged fallback)
GEMINI_API_KEY_2=""
CHAT_MODEL="gemini-3.1-flash-lite"
CHAT_MODEL_FALLBACK="gemini-3.1-flash-lite-preview"

# Transactional Notifications (Resend)
RESEND_API_KEY="re_your_resend_api_key"
CLINIC_EMAIL="appointments@theskintree.in"
SITE_URL="https://theskintree.in"

# Scheduled Jobs Secret (keepalive ping)
CRON_SECRET="your-high-entropy-cron-secret-32-chars-minimum"

# Rate Limiter (Upstash Redis REST - Optional, falls back to in-memory sliding window)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile Bot Protection (Optional in dev, recommended in prod)
TURNSTILE_SECRET_KEY=""

# Phone OTP Verification (Set to 'true' to strictly enforce 6-digit SMS OTP on booking)
REQUIRE_PHONE_OTP="false"
