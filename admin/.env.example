# =============================================================================
# The Skin Tree - Admin Portal Environment Variables (.env.example)
# Single Supabase Project with Role-Segregated Connections
# =============================================================================

# 1. PostgreSQL Pooled Connection Strings (Supavisor Transaction mode, Port 6543)
# Format: postgresql://<role>.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
ADMIN_BOOKING_DATABASE_URL="postgresql://admin_booking.YOUR_PROJECT_REF:YOUR_ADMIN_BOOKING_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
ADMIN_CLINICAL_DATABASE_URL="postgresql://admin_clinical.YOUR_PROJECT_REF:YOUR_ADMIN_CLINICAL_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Supabase Auth (Used solely for staff authentication & TOTP MFA verification; tables are locked)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"

# Client-accessible keys for Vite app (login form & MFA TOTP)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# 3. Communications & Cron
RESEND_API_KEY="re_your_resend_api_key"
CLINIC_EMAIL="concierge@theskintree.in"
SITE_URL="https://theskintree.in"
CRON_SECRET="your-high-entropy-cron-secret-32-chars-minimum"
